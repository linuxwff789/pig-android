{
  "version": 1,
  "sidebar": {
    "sections": [
      "sessions",
      "projects"
    ],
    "widthDp": 340
  },
  "chat": {
    "showUsage": true,
    "toolCards": "collapsed",
    "assistantLabel": "PIGGY",
    "toolGroups": true,
    "paddingH": 11,
    "paddingV": 8,
    "bottomPadding": 12,
    "messageSpacing": 10,
    "emptyAvatarSize": 40,
    "codeBlockRadius": 6,
    "bubble": {
      "paddingH": 11,
      "paddingV": 8,
      "borderWidth": 1,
      "textColor": "onSurface",
      "assistantBubble": false
    },
    "toolCard": {
      "background": "surfaceVariant",
      "backgroundAlpha": 0.55,
      "radius": 7,
      "borderWidth": 1,
      "borderAlpha": 0.35,
      "padding": 9,
      "collapsedPaddingH": 9,
      "collapsedPaddingV": 6,
      "iconBoxSize": 21,
      "iconSize": 12,
      "iconRadius": 4,
      "iconAlpha": 0.12,
      "titleSize": 11,
      "metricsColor": "onSurfaceVariant",
      "chipRadius": 4,
      "chipAlpha": 0.12,
      "groupRadius": 7,
      "groupPadding": 8
    },
    "thinking": {
      "show": true,
      "collapsedByDefault": true,
      "expandWhileStreaming": true,
      "showCount": true,
      "background": "surfaceVariant",
      "backgroundAlpha": 0.38,
      "titleColor": "secondary",
      "textColor": "onSurfaceVariant",
      "fontSize": 12,
      "radius": 8,
      "paddingH": 8,
      "paddingV": 5,
      "maxHeight": 200,
      "italic": false
    }
  },
  "composer": {
    "placeholder": "给 Pig 发消息…",
    "maxLines": 6,
    "sendOnEnter": true,
    "fontSize": 13,
    "minHeight": 36,
    "paddingH": 10,
    "paddingV": 7,
    "radius": 14,
    "inputRadius": 10,
    "buttonIconSize": 18
  },
  "skinSwitcher": {
    "show": true,
    "placement": "drawer",
    "style": "chips"
  },
  "packManager": {
    "show": true,
    "placement": "both"
  },
  "drawer": {
    "cornerRadius": 10,
    "spacing": 6,
    "buttonHeight": 34,
    "buttonRadius": 6,
    "sectionLabelSize": 9,
    "sessionRowRadius": 6,
    "searchRadius": 8,
    "brandAvatarSize": 28,
    "buttonIconSize": 13
  },
  "header": {
    "show": true,
    "height": 0,
    "paddingH": 10,
    "paddingV": 3,
    "background": "gradient",
    "gradientAlpha": 0.1,
    "divider": true,
    "rows": [
      {
        "spacing": 6,
        "align": "start",
        "elements": [
          {
            "type": "icon",
            "icon": "menu",
            "size": 22,
            "action": "header:menu",
            "color": "onSurface",
            "padding": 2
          },
          {
            "type": "text",
            "bind": "session.title",
            "text": "新会话",
            "style": "heading",
            "color": "onSurface",
            "weight": 1.0,
            "lines": 1
          },
          {
            "type": "icon",
            "icon": "refresh",
            "size": 18,
            "action": "header:reconnect",
            "when": "offline"
          }
        ]
      },
      {
        "spacing": 5,
        "align": "start",
        "elements": [
          {
            "type": "text",
            "bind": "state.model",
            "format": "{id}",
            "text": "点击选择模型",
            "action": "header:model",
            "style": "mono",
            "color": "onSurfaceVariant",
            "weight": 1.0
          },
          {
            "type": "icon",
            "icon": "chevronDown",
            "size": 12,
            "action": "header:model"
          },
          {
            "type": "usage"
          },
          {
            "type": "text",
            "bind": "stats",
            "format": "· {cacheHitRate}%",
            "text": "· —",
            "style": "mono"
          },
          {
            "type": "text",
            "bind": "state",
            "format": "· {thinkingLevel}",
            "text": "· —",
            "style": "mono",
            "color": "secondary",
            "action": "header:model"
          }
        ]
      }
    ]
  }
}
