{
  "version": 1,
  "sidebar": {
    "widthDp": 260,
    "sections": [
      "sessions",
      "projects"
    ]
  },
  "chat": {
    "assistantLabel": "PIG",
    "toolCards": "collapsed",
    "toolGroups": true,
    "showUsage": false,
    "paddingH": 10,
    "paddingV": 8,
    "bottomPadding": 12,
    "messageSpacing": 10,
    "emptyAvatarSize": 40,
    "codeBlockRadius": 6,
    "codeBlockBorderAlpha": 0.2,
    "bubble": {
      "paddingH": 10,
      "paddingV": 8,
      "borderWidth": 1,
      "textColor": "onSurface",
      "assistantBubble": false
    },
    "toolCard": {
      "background": "surface",
      "backgroundAlpha": 0.72,
      "radius": 6,
      "borderWidth": 1,
      "borderAlpha": 0.4,
      "padding": 8,
      "collapsedPaddingH": 8,
      "collapsedPaddingV": 6,
      "iconBoxSize": 20,
      "iconSize": 12,
      "iconRadius": 4,
      "iconAlpha": 0.12,
      "titleSize": 12,
      "metricsColor": "onSurfaceVariant",
      "chipRadius": 4,
      "chipAlpha": 0.12,
      "groupRadius": 6,
      "groupPadding": 8
    }
  },
  "composer": {
    "placeholder": "输入消息…",
    "maxLines": 5,
    "sendOnEnter": true,
    "placeholderColor": "textMuted",
    "fontSize": 12,
    "textColor": "onSurface",
    "minHeight": 40,
    "paddingH": 10,
    "paddingV": 8,
    "radius": 12,
    "inputRadius": 10,
    "inputAlpha": 0.28,
    "borderAlpha": 0.35,
    "elevation": 2,
    "surfaceAlpha": 1.0,
    "buttonIconSize": 18
  },
  "drawer": {
    "background": "surface",
    "gradientAlpha": 0.0,
    "cornerRadius": 14,
    "paddingH": 12,
    "paddingV": 14,
    "spacing": 8,
    "brandAvatarSize": 32,
    "brandTagline": false,
    "brandCardAlpha": 0.0,
    "brandPills": false,
    "buttonHeight": 36,
    "buttonRadius": 8,
    "buttonIconSize": 14,
    "sectionLabelSize": 10,
    "sectionLabelUppercase": true,
    "sessionRowRadius": 8,
    "sessionSelectedAlpha": 0.1,
    "showSessionId": false,
    "showSessionTime": false,
    "searchRadius": 10,
    "modules": [
      "newSession"
    ]
  },
  "skinSwitcher": {
    "show": true,
    "placement": "settings",
    "style": "list"
  },
  "packManager": {
    "show": true,
    "placement": "settings"
  },
  "header": {
    "show": true,
    "height": 46,
    "paddingH": 10,
    "paddingV": 2,
    "background": "surface",
    "gradientAlpha": 0.0,
    "divider": true,
    "body": {
      "type": "row",
      "spacing": 6,
      "children": [
        {
          "type": "icon",
          "icon": "menu",
          "size": 18,
          "action": "header:menu"
        },
        {
          "type": "text",
          "text": "PIG",
          "style": "heading"
        },
        {
          "type": "text",
          "bind": "state.model",
          "format": "{id}",
          "action": "header:model",
          "style": "label"
        },
        {
          "type": "icon",
          "icon": "chevronDown",
          "size": 12,
          "action": "header:model"
        },
        {
          "type": "spacer",
          "weight": 1.0
        },
        {
          "type": "text",
          "bind": "context",
          "format": "ctx {percentLabel} / {windowLabel}{mismatch}",
          "style": "label"
        },
        {
          "type": "text",
          "bind": "state.thinkingLevel",
          "format": "{value}",
          "style": "label"
        },
        {
          "type": "icon",
          "icon": "stop",
          "size": 18,
          "action": "header:stop",
          "visibleWhen": "busy"
        },
        {
          "type": "icon",
          "icon": "refresh",
          "size": 18,
          "action": "header:reconnect",
          "visibleWhen": "offline"
        }
      ]
    }
  },
  "dataSources": {
    "state": {
      "rpc": "get_state",
      "refresh": [
        "connect",
        "agent_end",
        "session_switch"
      ]
    },
    "stats": {
      "rpc": "get_session_stats",
      "refresh": [
        "agent_end",
        "compaction_end"
      ]
    }
  }
}
