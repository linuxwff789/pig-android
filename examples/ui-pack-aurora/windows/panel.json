{
  "appUI": 1,
  "id": "panel",
  "title": "Aurora inline panel",
  "placement": "aboveComposer",
  "width": 340,
  "height": 0,
  "body": {
    "type": "column",
    "spacing": 6,
    "children": [
      {
        "type": "text",
