{
  "version": 1,
  "sidebar": {
    "widthDp": 360,
    "sections": [
      "sessions",
      "projects"
    ]
  },
  "chat": {
    "assistantLabel": "AURORA",
    "toolCards": "expanded",
    "toolGroups": false,
    "showUsage": true,
    "paddingH": 16,
    "paddingV": 12,
    "bottomPadding": 20,
    "messageSpacing": 16,
    "emptyAvatarSize": 72,
    "codeBlockRadius": 14,
    "codeBlockBorderAlpha": 0.5,
    "bubble": {
      "paddingH": 16,
      "paddingV": 12,
      "borderWidth": 2,
      "textColor": "onSurface",
      "assistantBubble": true,
      "assistantBackgroundAlpha": 0.72,
      "assistantBorderAlpha": 0.45,
      "assistantTextColor": "onSurface"
    },
    "toolCard": {
      "background": "surfaceVariant",
      "backgroundAlpha": 0.55,
      "radius": 18,
      "borderWidth": 2,
      "borderAlpha": 0.55,
      "padding": 14,
      "collapsedPaddingH": 12,
      "collapsedPaddingV": 9,
      "iconBoxSize": 30,
      "iconSize": 17,
      "iconRadius": 10,
      "iconAlpha": 0.22,
      "titleSize": 15,
      "metricsColor": "secondary",
      "chipRadius": 10,
      "chipAlpha": 0.22,
      "groupRadius": 20,
      "groupPadding": 12
    }
  },
  "composer": {
    "placeholder": "向 Aurora 说点什么…",
    "maxLines": 8,
    "sendOnEnter": true,
    "placeholderColor": "secondary"
  },
  "skinSwitcher": {
    "show": true,
    "placement": "both",
    "style": "list"
  },
  "packManager": {
    "show": true,
    "placement": "both"
  },
  "dataSources": {
    "state": {
      "rpc": "get_state",
      "refresh": [
        "connect",
        "agent_end",
        "session_switch"
      ]
    },
    "stats": {
      "rpc": "get_session_stats",
      "refresh": [
        "agent_end",
        "compaction_end"
      ]
    },
    "lastAssistantText": {
      "rpc": "get_last_assistant_text",
      "refresh": [
        "agent_end"
      ]
    }
  },
  "bindings": {
    "header.title": {
      "path": "state.sessionName",
      "fallback": "Aurora"
    },
    "header.subtitle": {
      "path": "state.model",
      "format": "{provider}/{id}"
    },
    "header.usage": {
      "path": "stats.contextUsage",
      "format": "{percent}% · {tokens}/{contextWindow}"
    },
    "header.cache": {
      "path": "stats",
      "format": "缓存 {cacheHitRate}%"
    }
  },
  "actions": {
    "compact": {
      "rpc": "compact",
      "confirm": "用 Aurora pack 压缩当前上下文？"
    },
    "new": {
      "rpc": "new_session",
      "confirm": "开一个新对话？"
    },
    "abort": {
      "rpc": "abort"
    }
  },
  "header": {
    "show": true,
    "height": 74,
    "paddingH": 12,
    "paddingV": 3,
    "background": "gradient",
    "gradientAlpha": 0.24,
    "divider": true,
    "body": {
      "type": "column",
      "spacing": 2,
      "children": [
        {
          "type": "row",
          "spacing": 8,
          "children": [
            {
              "type": "icon",
              "icon": "menu",
              "size": 22,
              "action": "header:menu"
            },
            {
              "type": "avatar",
              "size": 36,
              "action": "header:menu"
            },
            {
              "type": "column",
              "spacing": 0,
              "weight": 1.0,
              "children": [
                {
                  "type": "text",
                  "text": "Aurora",
                  "style": "heading"
                },
                {
                  "type": "connection",
                  "color": "tertiary"
                }
              ]
            },
            {
              "type": "text",
              "bind": "context",
              "format": "{percentLabel} / {windowLabel}{pendingMark}",
              "style": "muted"
            },
            {
              "type": "icon",
              "icon": "stop",
              "size": 22,
              "action": "header:stop",
              "visibleWhen": "busy"
            },
            {
              "type": "icon",
              "icon": "refresh",
              "size": 22,
              "action": "header:reconnect",
              "visibleWhen": "offline"
            }
          ]
        },
        {
          "type": "row",
          "spacing": 8,
          "children": [
            {
              "type": "text",
              "bind": "state.model",
              "format": "{provider}/{id}",
              "style": "muted"
            },
            {
              "type": "divider",
              "size": 16
            },
            {
              "type": "text",
              "bind": "state.thinkingLevel",
              "format": "思考 {value}",
              "style": "muted"
            },
            {
              "type": "text",
              "bind": "state.pendingMessageCount",
              "format": "待处理 {value}",
              "style": "muted"
            },
            {
              "type": "spacer",
              "weight": 1.0
            },
            {
              "type": "icon",
              "icon": "settings",
              "size": 18,
              "action": "header:settings"
            },
            {
              "type": "icon",
              "icon": "add",
              "size": 18,
              "action": "header:new_session"
            }
          ]
        }
      ]
    }
  },
  "drawer": {
    "background": "gradient",
    "gradientAlpha": 0.22,
    "cornerRadius": 26,
    "paddingH": 18,
    "paddingV": 22,
    "spacing": 9,
    "brandAvatarSize": 48,
    "brandTagline": true,
    "brandCardAlpha": 0.42,
    "brandPills": true,
    "buttonHeight": 44,
    "buttonRadius": 14,
    "buttonIconSize": 18,
    "sectionLabelSize": 12,
    "sectionLabelUppercase": false,
    "sessionRowRadius": 16,
    "sessionSelectedAlpha": 0.18,
    "showSessionId": true,
    "showSessionTime": true,
    "searchRadius": 14,
    "modules": [
      "brand",
      "newSession",
      "skinSwitcher",
      "packManager",
      "panels"
    ]
  }
}
