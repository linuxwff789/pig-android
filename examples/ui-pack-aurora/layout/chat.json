{
  "version": 1,
  "sidebar": {
    "widthDp": 360,
    "sections": [
      "sessions",
      "projects"
    ]
  },
  "chat": {
    "assistantLabel": "AURORA",
    "toolCards": "expanded",
    "toolGroups": false,
    "showUsage": true
  },
  "composer": {
    "placeholder": "向 Aurora 说点什么…",
    "maxLines": 8,
    "sendOnEnter": true
  },
  "skinSwitcher": {
    "show": true,
    "placement": "both",
    "style": "list"
  },
  "packManager": {
    "show": true,
    "placement": "both"
  },
  "dataSources": {
    "state": {
      "rpc": "get_state",
      "refresh": [
        "connect",
        "agent_end",
        "session_switch"
      ]
    },
    "stats": {
      "rpc": "get_session_stats",
      "refresh": [
        "agent_end",
        "compaction_end"
      ]
    },
    "lastAssistantText": {
      "rpc": "get_last_assistant_text",
      "refresh": [
        "agent_end"
      ]
    }
  },
  "bindings": {
    "header.title": {
      "path": "state.sessionName",
      "fallback": "Aurora"
    },
    "header.subtitle": {
      "path": "state.model",
      "format": "{provider}/{id}"
    },
    "header.usage": {
      "path": "stats.contextUsage",
      "format": "{percent}% · {tokens}/{contextWindow}"
    },
    "header.cache": {
      "path": "stats",
      "format": "缓存 {cacheHitRate}%"
    }
  },
  "actions": {
    "compact": {
      "rpc": "compact",
      "confirm": "用 Aurora pack 压缩当前上下文？"
    },
    "new": {
      "rpc": "new_session",
      "confirm": "开一个新对话？"
    },
    "abort": {
      "rpc": "abort"
    }
  },
  "header": {
    "show": true,
    "height": 74,
    "paddingH": 12,
    "paddingV": 3,
    "background": "gradient",
    "gradientAlpha": 0.24,
    "divider": true,
    "rows": [
      {
        "spacing": 8,
        "align": "start",
        "elements": [
          {
            "type": "menu",
            "size": 22
          },
          {
            "type": "brand",
            "avatar": true,
            "avatarSize": 36,
            "online": true
          },
          {
            "type": "spacer"
          },
          {
            "type": "usage",
            "bind": "stats.contextUsage",
            "format": "{percent}%"
          },
          {
            "type": "cache",
            "bind": "stats",
            "format": "缓存 {cacheHitRate}%"
          },
          {
            "type": "status",
            "when": "busy",
            "style": "muted"
          },
          {
            "type": "stop",
            "when": "busy",
            "size": 22
          },
          {
            "type": "reconnect",
            "when": "offline",
            "size": 22
          }
        ]
      },
      {
        "spacing": 8,
        "align": "start",
        "height": 28,
        "elements": [
          {
            "type": "model"
          },
          {
            "type": "divider",
            "size": 18
          },
          {
            "type": "text",
            "bind": "state.thinkingLevel",
            "format": "思考 {value}",
            "style": "muted"
          },
          {
            "type": "text",
            "bind": "state.pendingMessageCount",
            "format": "待处理 {value}",
            "style": "muted"
          },
          {
            "type": "spacer"
          },
          {
            "type": "icon",
            "icon": "settings",
            "action": "settings",
            "size": 18
          },
          {
            "type": "icon",
            "icon": "add",
            "action": "new_session",
            "size": 18
          }
        ]
      }
    ]
  }
}
