<?xml version="1.0" encoding="utf-8"?>
<!--
  The relay is always loopback, but WebDAV backups are user-provided: NAS boxes
  and self-hosted servers are often plain http on the LAN. Cleartext is allowed
  app-wide for that reason; the WebDAV dialog still recommends https, and a
  self-signed certificate is opt-in per server ("忽略证书错误").
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
