<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: AI-generated 3D pig (gpt-image-2) split into layers.
     Background is the same artwork with the subject inpainted away, so the
     foreground can parallax without revealing a seam. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_fg" />
    <monochrome android:drawable="@mipmap/ic_launcher_mono" />
</adaptive-icon>
