{
  "version": 1,
  "sidebar": {
    "sections": [
      "sessions",
      "projects"
    ],
    "widthDp": 340
  },
  "chat": {
    "showUsage": true,
    "immersive": true,
    "toolCards": "collapsed",
    "assistantLabel": "PIGGY",
    "toolGroups": true,
    "paddingH": 11,
    "paddingV": 8,
    "bottomPadding": 12,
    "messageSpacing": 10,
    "emptyAvatarSize": 40,
    "codeBlockRadius": 6,
    "bubble": {
      "paddingH": 11,
      "paddingV": 8,
      "borderWidth": 1,
      "textColor": "onSurface",
      "assistantBubble": false
    },
    "toolCard": {
      "background": "surfaceVariant",
      "backgroundAlpha": 0.55,
      "radius": 7,
      "borderWidth": 1,
      "borderAlpha": 0.35,
      "padding": 9,
      "collapsedPaddingH": 9,
      "collapsedPaddingV": 6,
      "iconBoxSize": 21,
      "iconSize": 12,
      "iconRadius": 4,
      "iconAlpha": 0.12,
      "titleSize": 11,
      "metricsColor": "onSurfaceVariant",
      "chipRadius": 4,
      "chipAlpha": 0.12,
      "groupRadius": 7,
      "groupPadding": 8,
      "byTool": {
        "bash": {
          "iconTint": "success",
          "iconBackground": "success",
          "titleColor": "success"
        },
        "edit": {
          "iconTint": "warning",
          "iconBackground": "warning",
          "titleColor": "warning"
        },
        "write": {
          "iconTint": "warning",
          "iconBackground": "warning",
          "titleColor": "warning"
        },
        "read": {
          "iconTint": "secondary",
          "iconBackground": "secondary",
          "titleColor": "secondary"
        },
        "webfetch": {
          "iconTint": "primary",
          "iconBackground": "primary",
          "titleColor": "primary"
        },
        "websearch": {
          "iconTint": "primary",
          "iconBackground": "primary",
          "titleColor": "primary"
        },
        "memory*": {
          "iconTint": "tertiary",
          "iconBackground": "tertiary",
          "titleColor": "tertiary"
        },
        "scratchpad": {
          "iconTint": "tertiary",
          "iconBackground": "tertiary",
          "titleColor": "tertiary"
        },
        "codegraph*": {
          "iconTint": "tertiary",
          "iconBackground": "tertiary",
          "titleColor": "tertiary"
        },
        "subagent": {
          "iconTint": "primary",
          "iconBackground": "primary",
          "titleColor": "primary"
        }
      }
    },
    "thinking": {
      "show": true,
      "collapsedByDefault": true,
      "expandWhileStreaming": true,
      "showCount": true,
      "background": "surfaceVariant",
      "backgroundAlpha": 0.38,
      "titleColor": "secondary",
      "textColor": "onSurfaceVariant",
      "fontSize": 12,
      "radius": 8,
      "paddingH": 8,
      "paddingV": 5,
      "maxHeight": 200,
      "italic": false
    },
    "chrome": {
      "fabBackgroundAlpha": 0.5
    }
  },
  "composer": {
    "placeholder": "给 Pig 发消息…",
    "maxLines": 6,
    "sendOnEnter": true,
    "fontSize": 13,
    "minHeight": 36,
    "paddingH": 10,
    "paddingV": 7,
    "radius": 14,
    "inputRadius": 10,
    "buttonIconSize": 18
  },
  "settings": {
    "defaultSize": "standard",
    "sizes": [
      {
        "id": "compact",
        "label": "紧凑",
        "width": 0.8,
        "height": 0.64
      },
      {
        "id": "standard",
        "label": "标准",
        "width": 0.94,
        "height": 0.86
      },
      {
        "id": "large",
        "label": "大",
        "width": 0.99,
        "height": 0.96
      }
    ]
  },
  "skinSwitcher": {
    "show": true,
    "placement": "drawer",
    "style": "chips"
  },
  "packManager": {
    "show": true,
    "placement": "both"
  },
  "drawer": {
    "cornerRadius": 16,
    "spacing": 8,
    "buttonHeight": 48,
    "buttonRadius": 10,
    "sectionLabelSize": 11,
    "sessionRowRadius": 10,
    "searchRadius": 12,
    "brandAvatarSize": 32,
    "buttonIconSize": 20
  },
  "header": {
    "show": true,
    "height": 0,
    "paddingH": 14,
    "paddingV": 6,
    "background": "gradient",
    "gradientAlpha": 0.16,
    "divider": true,
    "rows": [
      {
        "spacing": 8,
        "align": "start",
        "elements": [
          {
            "type": "menu",
            "icon": "menu",
            "size": 30,
            "action": "header:menu",
            "color": "onSurface",
            "padding": 2
          },
          {
            "type": "text",
            "bind": "session.title",
            "text": "新会话",
            "style": "heading",
            "color": "onSurface",
            "weight": 1.0,
            "lines": 1
          },
          {
            "type": "icon",
            "icon": "refresh",
            "size": 24,
            "action": "header:reconnect",
            "when": "offline"
          }
        ]
      },
      {
        "spacing": 7,
        "align": "start",
        "elements": [
          {
            "type": "pill",
            "bind": "state.model",
            "text": "点击选择模型",
            "action": "header:model",
            "color": "onSurfaceVariant",
            "weight": 1.0
          },
          {
            "type": "icon",
            "icon": "chevronDown",
            "size": 16,
            "action": "header:model"
          },
          {
            "type": "usage"
          },
          {
            "type": "text",
            "bind": "stats",
            "format": "· {cacheHitRate}%",
            "text": "· —",
            "style": "mono"
          },
          {
            "type": "text",
            "bind": "state",
            "format": "· {thinkingLevel}",
            "text": "· —",
            "style": "mono",
            "color": "secondary",
            "action": "header:model"
          }
        ]
      }
    ]
  }
}
